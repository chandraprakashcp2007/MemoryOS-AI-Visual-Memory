@dataclass(slots=True)
class ProcessingDiagnostics:
    """
    Explainable processing diagnostics.

    Useful for:
        - debugging
        - analytics
        - API responses
        - hackathon demo
        - production monitoring
    """

    started_at: str = ""

    completed_at: str = ""

    duration_ms: float = 0.0

    image_loaded: bool = False

    ocr_attempted: bool = False

    ocr_success: bool = False

    vision_attempted: bool = False

    vision_success: bool = False

    embedding_attempted: bool = False

    embedding_success: bool = False

    vector_index_attempted: bool = False

    vector_index_success: bool = False

    fallback_used: bool = False

    duplicate_detected: bool = False

    error_count: int = 0

    warnings: list[str] = field(default_factory=list)

    errors: list[str] = field(default_factory=list)

    stages: dict[str, float] = field(default_factory=dict)

    def add_warning(self, message: Any) -> None:
        value = str(message).strip()

        if value and value not in self.warnings:
            self.warnings.append(value)

    def add_error(self, message: Any) -> None:
        value = str(message).strip()

        if value and value not in self.errors:
            self.errors.append(value)

        self.error_count = len(self.errors)

    def to_dict(self) -> dict[str, Any]:
        return {
            "started_at": self.started_at,
            "completed_at": self.completed_at,
            "duration_ms": round(self.duration_ms, 2),
            "image_loaded": self.image_loaded,
            "ocr_attempted": self.ocr_attempted,
            "ocr_success": self.ocr_success,
            "vision_attempted": self.vision_attempted,
            "vision_success": self.vision_success,
            "embedding_attempted": self.embedding_attempted,
            "embedding_success": self.embedding_success,
            "vector_index_attempted": self.vector_index_attempted,
            "vector_index_success": self.vector_index_success,
            "fallback_used": self.fallback_used,
            "duplicate_detected": self.duplicate_detected,
            "error_count": self.error_count,
            "warnings": list(self.warnings),
            "errors": list(self.errors),
            "stages": dict(self.stages),
        }


