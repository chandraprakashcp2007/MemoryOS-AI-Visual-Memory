def _clean_string(value: Any) -> str:
    if value is None:
        return ""

    if isinstance(value, bytes):
        value = value.decode(
            "utf-8",
            errors="replace",
        )

    return (
        str(value)
        .replace(
            "\x00",
            " ",
        )
        .strip()
    )


def _safe_float(
    value: Any,
    default: float = 0.0,
) -> float:
    try:
        return float(value)
    except (
        TypeError,
        ValueError,
    ):
        return default


def _safe_list(value: Any) -> list[Any]:
    if value is None:
        return []

    if isinstance(value, str):
        return [value] if value.strip() else []

    if isinstance(
        value,
        (list, tuple, set),
    ):
        return list(value)

    return []


def _vision_to_dict(
    vision: Any,
) -> dict[str, Any]:
    """
    Convert VisionAnalysis or compatible objects into a dictionary.
    """

    if vision is None:
        return {}

    if hasattr(
        vision,
        "__dict__",
    ):
        return dict(vision.__dict__)

    fields = (
        "success",
        "title",
        "summary",
        "category",
        "subcategory",
        "entities",
        "people",
        "organizations",
        "locations",
        "products",
        "dates",
        "prices",
        "emails",
        "phone_numbers",
        "urls",
        "intent",
        "keywords",
        "importance",
        "visual_description",
        "actionable_items",
        "model",
        "fallback",
        "error",
        "metadata",
    )

    result: dict[str, Any] = {}

    for field_name in fields:
        if hasattr(
            vision,
            field_name,
        ):
            value = getattr(
                vision,
                field_name,
            )

            if isinstance(
                value,
                tuple,
            ):
                value = list(value)

            result[field_name] = value

    return result


# ============================================================================
# FILE / BYTES UTILITIES
# ============================================================================


def _read_source_bytes(
    source: Any,
) -> bytes:
    """
    Read supported source types into bytes.

    Supported:
        - bytes
        - bytearray
        - pathlib.Path
        - string path
        - file-like object
    """

    if source is None:
        raise ProcessingInputError("Image source cannot be None.")

    if isinstance(
        source,
        bytes,
    ):
        return source

    if isinstance(
        source,
        bytearray,
    ):
        return bytes(source)

    if isinstance(
        source,
        Path,
    ):
        try:
            return source.read_bytes()
        except OSError as exc:
            raise ProcessingInputError(f"Unable to read image file: {exc}") from exc

    if isinstance(
        source,
        str,
    ):
        path = Path(source)

        try:
            return path.read_bytes()
        except OSError as exc:
            raise ProcessingInputError(f"Unable to read image file: {exc}") from exc

    if hasattr(
        source,
        "read",
    ):
        try:
            current_position = None

            if hasattr(
                source,
                "tell",
            ):
                try:
                    current_position = source.tell()
                except Exception:
                    current_position = None

            data = source.read()

            if current_position is not None and hasattr(
                source,
                "seek",
            ):
                try:
                    source.seek(current_position)
                except Exception:
                    pass

            if isinstance(
                data,
                bytes,
            ):
                return data

            if isinstance(
                data,
                bytearray,
            ):
                return bytes(data)

        except Exception as exc:
            raise ProcessingInputError(f"Unable to read image stream: {exc}") from exc

    raise ProcessingInputError(
        f"Unsupported image source type: {type(source).__name__}"
    )


def _source_filename(
    source: Any,
) -> str:
    if isinstance(
        source,
        Path,
    ):
        return source.name

    if isinstance(
        source,
        str,
    ):
        return Path(source).name

    name = getattr(
        source,
        "filename",
        None,
    )

    if name:
        return Path(str(name)).name

    return "memory_image"


def _detect_mime(
    filename: str,
    image: Image.Image,
) -> str:
    """
    Detect MIME type using both filename and PIL format.
    """

    guessed, _ = mimetypes.guess_type(filename)

    if guessed in SUPPORTED_MIME_TYPES:
        return guessed

    image_format = str(image.format or "").upper()

    mapping = {
        "JPEG": "image/jpeg",
        "JPG": "image/jpeg",
        "PNG": "image/png",
        "WEBP": "image/webp",
    }

    return mapping.get(
        image_format,
        "image/jpeg",
    )


def _calculate_sha256(
    data: bytes,
) -> str:
    return hashlib.sha256(data).hexdigest()


# ============================================================================
# IMAGE VALIDATION
# ============================================================================


def _validate_image(
    data: bytes,
    filename: str,
) -> Image.Image:
    """
    Validate image bytes using Pillow.

    This protects downstream services from malformed inputs.
    """

    if not data:
        raise ProcessingInputError("Image file is empty.")

    if len(data) > MAX_IMAGE_SIZE_BYTES:
        raise ProcessingInputError("Image exceeds the 10 MB processing limit.")

    extension = Path(filename).suffix.lower()

    if extension and extension not in SUPPORTED_EXTENSIONS:
        raise ProcessingInputError(f"Unsupported image extension: {extension}")

    try:
        from io import BytesIO

        image = Image.open(BytesIO(data))

        image.verify()

        # Re-open after verify because verify() invalidates the image.
        image = Image.open(BytesIO(data))

        return image

    except Exception as exc:
        raise ProcessingInputError(f"Invalid or unreadable image: {exc}") from exc


# ============================================================================
# IMAGE METADATA
# ============================================================================


def _build_image_info(
    *,
    source: Any,
    data: bytes,
    image: Image.Image,
) -> ImageInfo:
    filename = _source_filename(source)

    mime_type = _detect_mime(
        filename,
        image,
    )

    extension = Path(filename).suffix.lower()

    return ImageInfo(
        filename=filename,
        mime_type=mime_type,
        extension=extension,
        width=image.width,
        height=image.height,
        file_size_bytes=len(data),
        image_hash=_calculate_sha256(data),
        original_path=(
            str(source)
            if isinstance(
                source,
                (str, Path),
            )
            else None
        ),
        format=str(image.format or ""),
        mode=str(image.mode or ""),
    )


