class _OCRAdapter:
    """
    Compatibility adapter around the project's OCR service.

    The project has evolved through multiple OCR implementations,
    so this adapter supports common method names without forcing
    the orchestration layer to know implementation details.
    """

    def __init__(
        self,
        service: Any,
    ) -> None:
        self.service = service

    def extract(
        self,
        source: Any,
    ) -> str:
        if self.service is None:
            raise ProcessingOCRWarning("OCR service is unavailable.")

        method_names = (
            "extract_text",
            "extract",
            "ocr",
            "process",
            "run",
        )

        for method_name in method_names:
            method = getattr(
                self.service,
                method_name,
                None,
            )

            if not callable(method):
                continue

            try:
                result = method(source)

            except TypeError:
                continue

            return self._normalize_result(result)

        raise ProcessingOCRWarning("No compatible OCR extraction method found.")

    @staticmethod
    def _normalize_result(
        result: Any,
    ) -> str:
        if result is None:
            return ""

        if isinstance(
            result,
            str,
        ):
            return result.strip()

        if isinstance(
            result,
            Mapping,
        ):
            for key in (
                "text",
                "raw_text",
                "cleaned_text",
                "ocr_text",
            ):
                if key in result:
                    return _clean_string(result[key])

        for attribute in (
            "text",
            "raw_text",
            "cleaned_text",
            "ocr_text",
        ):
            value = getattr(
                result,
                attribute,
                None,
            )

            if value:
                return _clean_string(value)

        return _clean_string(result)


