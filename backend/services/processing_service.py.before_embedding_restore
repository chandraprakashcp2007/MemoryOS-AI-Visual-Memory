def _utc_now_iso() -> str:
    from datetime import datetime, timezone

    return datetime.now(timezone.utc).isoformat()


def _elapsed_ms(start: float) -> float:
    return round(
        (time.perf_counter() - start) * 1000,
        2,
    )


