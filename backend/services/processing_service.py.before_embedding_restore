class _VectorStoreAdapter:
    """
    Compatibility adapter for FAISS/vector store implementations.

    The adapter deliberately keeps FAISS details outside the processing
    orchestration layer.
    """

    def __init__(
        self,
        store: Any,
    ) -> None:
        self.store = store

    def index(
        self,
        *,
        memory: Memory,
        embedding: Any,
    ) -> bool:
        if self.store is None:
            raise ProcessingIndexError("Vector store is unavailable.")

        candidates = (
            "add",
            "add_vector",
            "add_embedding",
            "index",
            "upsert",
            "insert",
        )

        for method_name in candidates:
            method = getattr(
                self.store,
                method_name,
                None,
            )

            if not callable(method):
                continue

            attempts = (
                {
                    "memory": memory,
                    "embedding": embedding,
                },
                {
                    "vector": embedding,
                    "memory": memory,
                },
                {
                    "embedding": embedding,
                    "memory_id": memory.id,
                },
                {
                    "vector": embedding,
                    "memory_id": memory.id,
                },
                {
                    "embedding": embedding,
                    "id": memory.id,
                },
                {
                    "vector": embedding,
                    "id": memory.id,
                },
            )

            for kwargs in attempts:
                try:
                    result = method(**kwargs)

                    if result is False:
                        continue

                    return True

                except TypeError:
                    continue

                except Exception as exc:
                    raise ProcessingIndexError(
                        f"Vector indexing failed: {exc}"
                    ) from exc

        raise ProcessingIndexError("No compatible vector-store indexing method found.")


