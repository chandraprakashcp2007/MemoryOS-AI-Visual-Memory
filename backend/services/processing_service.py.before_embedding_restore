class _EmbeddingAdapter:
    """
    Compatibility adapter for the existing embedding service.
    """

    def __init__(
        self,
        service: Any,
    ) -> None:
        self.service = service

    @property
    def dimension(self) -> int:
        """
        Return the embedding vector dimension from the
        underlying embedding service.
        """

        if self.service is None:
            raise ProcessingEmbeddingError(
                "Embedding service is unavailable."
            )

        dimension = getattr(
            self.service,
            "dimension",
            None,
        )

        if dimension is None:
            raise ProcessingEmbeddingError(
                "Embedding service does not expose a dimension."
            )

        try:
            dimension = int(dimension)
        except (TypeError, ValueError) as exc:
            raise ProcessingEmbeddingError(
                "Embedding dimension is invalid."
            ) from exc

        if dimension <= 0:
            raise ProcessingEmbeddingError(
                "Embedding dimension must be greater than zero."
            )

        return dimension

    def generate(
        self,
        text: str,
    ) -> Any:
        if self.service is None:
            raise ProcessingEmbeddingError("Embedding service is unavailable.")

        method_names = (
            "embed",
            "embed_text",
            "encode",
            "generate_embedding",
            "create_embedding",
        )

        for method_name in method_names:
            method = getattr(
                self.service,
                method_name,
                None,
            )

            if not callable(method):
                continue

            try:
                result = method(text)
            except TypeError:
                continue

            if result is None:
                raise ProcessingEmbeddingError("Embedding service returned no vector.")

            return result

        raise ProcessingEmbeddingError("No compatible embedding method found.")


