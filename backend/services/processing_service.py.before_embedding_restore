class ProcessingService:
    """
    Premium MemoryOS ingestion orchestrator.

    The service intentionally coordinates existing components instead of
    reimplementing them.

    Main public operation:

        process(source)

    Example:

        result = processing_service.process(
            "screenshot.png"
        )

        memory = result.memory
    """

    def __init__(
        self,
        *,
        memory_service_instance: MemoryService | None = None,
        vision_service_instance: Any = None,
        ocr_service_instance: Any = None,
        embedding_service_instance: Any = None,
        vector_store_instance: Any = None,
        max_ocr_text: int = DEFAULT_MAX_OCR_TEXT,
        max_errors: int = DEFAULT_MAX_ERRORS,
    ) -> None:

        self.memory_service = memory_service_instance or memory_service

        self.vision_service = (
            vision_service_instance
            if vision_service_instance is not None
            else vision_service
        )

        self.ocr = _OCRAdapter(
            ocr_service_instance if ocr_service_instance is not None else ocr_service
        )

        self.embedding = _EmbeddingAdapter(
            embedding_service_instance
            if embedding_service_instance is not None
            else get_embedding_service()
        )

        self.vector_store = _VectorStoreAdapter(
            vector_store_instance if vector_store_instance is not None else vector_store
        )

        self.max_ocr_text = max(
            100,
            int(max_ocr_text),
        )

        self.max_errors = max(
            1,
            int(max_errors),
        )

    # ========================================================================
    # VISION
    # ========================================================================

    def _run_vision(
        self,
        source: Any,
        ocr_text: str,
    ) -> VisionAnalysis | None: # type: ignore
        """
        Run Gemini Vision.

        OCR is passed as supporting context only.
        """

        if self.vision_service is None:
            raise ProcessingVisionWarning("Vision service is unavailable.")

        # Prefer OCR-aware method because it preserves the architecture:
        #
        # Image â†’ Vision
        #          â†‘
        #       OCR support
        #
        method = getattr(
            self.vision_service,
            "analyze_with_ocr",
            None,
        )

        if callable(method):
            return method(
                source,
                ocr_text,
                allow_fallback=True,
            )

        method = getattr(
            self.vision_service,
            "analyze",
            None,
        )

        if callable(method):
            return method(
                source,
                allow_fallback=True,
            )

        raise ProcessingVisionWarning("No compatible Vision analysis method found.")

