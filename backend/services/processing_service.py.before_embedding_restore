    @staticmethod
    def _vision_value(
        vision: Any,
        name: str,
        default: Any = None,
    ) -> Any:
        if vision is None:
            return default

        return getattr(
            vision,
            name,
            default,
        )

    @staticmethod
    def _vision_entities(
        vision: Any,
    ) -> list[MemoryEntity]:
        """
        Convert VisionAnalysis structured fields into MemoryEntity objects.

        Vision service returns multiple semantic collections.
        MemoryService expects a unified entity representation.
        """

        if vision is None:
            return []

        result: list[MemoryEntity] = []

        def add_values(
            values: Any,
            entity_type: str,
        ) -> None:

            for value in _safe_list(values):

                text = _clean_string(value)

                if not text:
                    continue

                result.append(
                    MemoryEntity(
                        text=text,
                        entity_type=entity_type,
                        confidence=0.90,
                        source="gemini_vision",
                    )
                )

        add_values(
            ProcessingService._vision_value(
                vision,
                "people",
                (),
            ),
            "PERSON",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "organizations",
                (),
            ),
            "ORGANIZATION",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "locations",
                (),
            ),
            "LOCATION",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "products",
                (),
            ),
            "PRODUCT",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "dates",
                (),
            ),
            "DATE",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "prices",
                (),
            ),
            "PRICE",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "emails",
                (),
            ),
            "EMAIL",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "phone_numbers",
                (),
            ),
            "PHONE",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "urls",
                (),
            ),
            "URL",
        )

        add_values(
            ProcessingService._vision_value(
                vision,
                "entities",
                (),
            ),
            "ENTITY",
        )

        return result

    # ========================================================================
    # CATEGORY CONFIDENCE
    # ========================================================================

    @staticmethod
    def _vision_confidence(
        vision: Any,
    ) -> float:
        """
        Gemini Vision does not currently expose an explicit confidence field.

        Therefore this derives a conservative signal from whether Gemini
        successfully produced meaningful structured visual analysis.
        """

        if vision is None:
            return 0.0

        success = bool(
            getattr(
                vision,
                "success",
                False,
            )
        )

        fallback = bool(
            getattr(
                vision,
                "fallback",
                False,
            )
        )

        category = _clean_string(
            getattr(
                vision,
                "category",
                "",
            )
        )

        description = _clean_string(
            getattr(
                vision,
                "visual_description",
                "",
            )
        )

        if not success or fallback:
            return 0.0

        score = 0.50

        if category:
            score += 0.20

        if description:
            score += 0.20

        if getattr(
            vision,
            "products",
            (),
        ) or getattr(
            vision,
            "entities",
            (),
        ):
            score += 0.10

        return min(
            score,
            1.0,
        )

    # ========================================================================
    # OCR QUALITY
    # ========================================================================

    @staticmethod
    def _estimate_ocr_quality(
        text: str,
    ) -> float:
        """
        Lightweight deterministic OCR quality estimate.

        This is deliberately not a language model.

        Signals:
            - text presence
            - length
            - printable character ratio
            - excessive noise
        """

        if not text:
            return 0.0

        value = text.strip()

        if not value:
            return 0.0

        length_score = min(
            len(value) / 100.0,
            1.0,
        )

        printable = sum(1 for character in value if character.isprintable())

        printable_ratio = printable / max(
            len(value),
            1,
        )

        noise = len(
            [
                token
                for token in value.split()
                if len(token) == 1 and not token.isalnum()
            ]
        )

        noise_penalty = min(
            noise
            / max(
                len(value.split()),
                1,
            ),
            0.5,
        )

        score = 0.45 * length_score + 0.55 * printable_ratio - noise_penalty

        return max(
            0.0,
            min(
                1.0,
                score,
            ),
        )

    # ========================================================================
    # MEMORY CONSTRUCTION
    # ========================================================================

    def _build_memory(
        self,
        *,
        source: Any,
        image_info: ImageInfo,
        ocr_text: str,
        vision: Any,
        source_name: str,
        metadata: Mapping[str, Any] | None,
        processing_errors: Sequence[str],
    ) -> Memory:
        """
        Merge all signals into the canonical Memory representation.
        """

        vision_title = self._vision_value(
            vision,
            "title",
            "",
        )

        vision_summary = self._vision_value(
            vision,
            "summary",
            "",
        )

        vision_category = self._vision_value(
            vision,
            "category",
            None,
        )

        vision_intent = self._vision_value(
            vision,
            "intent",
            None,
        )

        vision_keywords = self._vision_value(
            vision,
            "keywords",
            (),
        )

        vision_subcategory = self._vision_value(
            vision,
            "subcategory",
            "",
        )

        visual_description = self._vision_value(
            vision,
            "visual_description",
            "",
        )

        vision_entities = self._vision_entities(vision)

        # --------------------------------------------------------------------
        # AI analysis snapshot
        # --------------------------------------------------------------------

        ai_analysis: dict[str, Any] = {}

        if vision is not None:
            ai_analysis = _vision_to_dict(vision)

            # raw_response can be very large and may contain unnecessary
            # data in database records. Keep it out of the canonical
            # analysis payload.
            ai_analysis.pop(
                "raw_response",
                None,
            )

        # --------------------------------------------------------------------
        # Searchable metadata
        # --------------------------------------------------------------------

        final_metadata = dict(metadata or {})

        final_metadata.update(
            {
                "processing_schema_version": PROCESSING_SCHEMA_VERSION,
                "source_name": source_name,
                "image_hash": image_info.image_hash,
                "image_width": image_info.width,
                "image_height": image_info.height,
                "image_size_bytes": image_info.file_size_bytes,
                "image_mime_type": image_info.mime_type,
                "ocr_quality": self._estimate_ocr_quality(ocr_text),
                "vision_available": vision is not None,
                "vision_fallback": bool(
                    self._vision_value(
                        vision,
                        "fallback",
                        False,
                    )
                ),
            }
        )

        if vision_subcategory:
            final_metadata["visual_subcategory"] = _clean_string(vision_subcategory)

        if visual_description:
            final_metadata["visual_description"] = _clean_string(visual_description)

        if vision_summary:
            final_metadata["visual_summary"] = _clean_string(vision_summary)

        # --------------------------------------------------------------------
        # Image metadata
        # --------------------------------------------------------------------

        image_metadata = MemoryImageMetadata(
            filename=image_info.filename,
            mime_type=image_info.mime_type,
            width=image_info.width,
            height=image_info.height,
            file_size_bytes=image_info.file_size_bytes,
            image_hash=image_info.image_hash,
            thumbnail_path=image_info.thumbnail_path,
            original_path=image_info.original_path,
        )

        # --------------------------------------------------------------------
        # Build canonical memory
        # --------------------------------------------------------------------

        memory = self.memory_service.build_memory(
            raw_text=ocr_text,
            cleaned_text=ocr_text,
            title=vision_title,
            category=vision_category,
            intent=vision_intent,
            entities=vision_entities,
            classification_confidence=self._vision_confidence(vision),
            intent_confidence=(
                0.85
                if vision
                and self._vision_value(
                    vision,
                    "intent",
                    "",
                )
                and self._vision_value(
                    vision,
                    "intent",
                    "unknown",
                )
                != "unknown"
                else 0.0
            ),
            vision_confidence=self._vision_confidence(vision),
            ocr_quality=self._estimate_ocr_quality(ocr_text),
            source=source_name,
            image=image_metadata,
            image_hash=image_info.image_hash,
            ai_analysis=ai_analysis,
            metadata=final_metadata,
            tags=vision_keywords,
            processing_errors=processing_errors,
        )

        return memory

    # ========================================================================
    # EMBEDDING
    # ========================================================================

    def _generate_embedding(
        self,
        memory: Memory,
    ) -> Any:
        """
        Generate embedding from canonical embedding_text.

        The embedding service receives MemoryService's semantic representation,
        not raw OCR alone.
        """

        if not memory.embedding_text:
            raise ProcessingEmbeddingError("Memory has no embedding text.")

        return self.embedding.generate(memory.embedding_text)

    # ========================================================================
    # INDEX
    # ========================================================================

    def _index_memory(
        self,
        *,
        memory: Memory,
        embedding: Any,
    ) -> bool:
        return self.vector_store.index(
            memory=memory,
            embedding=embedding,
        )

    # ========================================================================
    # MAIN PROCESS
    # ========================================================================

    def process(
        self,
        source: Any,
        *,
        source_name: str = DEFAULT_SOURCE,
        metadata: Mapping[str, Any] | None = None,
        index: bool = True,
        allow_partial_success: bool = True,
    ) -> ProcessingResult:
        """
        Process one image through the complete MemoryOS pipeline.

        Parameters
        ----------
        source:
            Image path, bytes, Path, or file-like object.

        source_name:
            Logical origin, e.g.

                upload
                screenshot_scanner
                auto_capture

        metadata:
            Optional caller-provided metadata.

        index:
            Whether to generate embedding and add the memory to FAISS.

        allow_partial_success:
            When True, OCR/Vision/embedding/index failures are recorded
            instead of destroying the entire processing operation.
        """

        started = time.perf_counter()

        diagnostics = ProcessingDiagnostics(started_at=_utc_now_iso())

        errors: list[str] = []

        image_info = ImageInfo()

        ocr_text = ""

        vision = None

        embedding = None

        memory: Memory | None = None

        indexed = False

        try:

            # =================================================================
            # STAGE 1 â€” READ IMAGE
            # =================================================================

            stage_start = time.perf_counter()

            data = _read_source_bytes(source)

            filename = _source_filename(source)

            image = _validate_image(
                data,
                filename,
            )

            diagnostics.stages["image_validation"] = _elapsed_ms(stage_start)

            diagnostics.image_loaded = True

            try:

                image_info = _build_image_info(
                    source=source,
                    data=data,
                    image=image,
                )

            finally:

                try:
                    image.close()
                except Exception:
                    pass

            # =================================================================
            # STAGE 2 â€” OCR
            # =================================================================

            stage_start = time.perf_counter()

            diagnostics.ocr_attempted = True

            try:

                ocr_text = self.ocr.extract(source)

                ocr_text = _clean_string(ocr_text)[: self.max_ocr_text]

                diagnostics.ocr_success = True

            except Exception as exc:

                message = f"OCR processing failed: {exc}"

                diagnostics.add_warning(message)

                errors.append(message)

                ocr_text = ""

                if not allow_partial_success:
                    raise

            diagnostics.stages["ocr"] = _elapsed_ms(stage_start)

            # =================================================================
            # STAGE 3 â€” GEMINI VISION
            # =================================================================

            stage_start = time.perf_counter()

            diagnostics.vision_attempted = True

            try:

                vision = self._run_vision(
                    source,
                    ocr_text,
                )

                diagnostics.vision_success = bool(
                    vision
                    and getattr(
                        vision,
                        "success",
                        False,
                    )
                    and not getattr(
                        vision,
                        "fallback",
                        False,
                    )
                )

                if vision is not None and getattr(
                    vision,
                    "fallback",
                    False,
                ):
                    diagnostics.fallback_used = True

                    vision_error = getattr(
                        vision,
                        "error",
                        None,
                    )

                    if vision_error:
                        diagnostics.add_warning(f"Vision fallback: {vision_error}")

            except Exception as exc:

                message = f"Vision processing failed: {exc}"

                diagnostics.add_warning(message)

                errors.append(message)

                vision = None

                if not allow_partial_success:
                    raise

            diagnostics.stages["vision"] = _elapsed_ms(stage_start)

            # =================================================================
            # STAGE 4 â€” BUILD MEMORY
            # =================================================================

            stage_start = time.perf_counter()

            memory = self._build_memory(
                source=source,
                image_info=image_info,
                ocr_text=ocr_text,
                vision=vision,
                source_name=source_name,
                metadata=metadata,
                processing_errors=errors,
            )

            diagnostics.stages["memory"] = _elapsed_ms(stage_start)

            # =================================================================
            # STAGE 5 â€” EMBEDDING
            # =================================================================

            if index:

                stage_start = time.perf_counter()

                diagnostics.embedding_attempted = True

                try:

                    embedding = self._generate_embedding(memory)

                    diagnostics.embedding_success = True

                except Exception as exc:

                    message = f"Embedding generation failed: {exc}"

                    diagnostics.add_error(message)

                    errors.append(message)

                    if not allow_partial_success:
                        raise

                diagnostics.stages["embedding"] = _elapsed_ms(stage_start)

            # =================================================================
            # STAGE 6 â€” FAISS INDEX
            # =================================================================

            if index and embedding is not None:

                stage_start = time.perf_counter()

                diagnostics.vector_index_attempted = True

                try:

                    indexed = self._index_memory(
                        memory=memory,
                        embedding=embedding,
                    )

                    diagnostics.vector_index_success = indexed

                except Exception as exc:

                    message = f"Vector indexing failed: {exc}"

                    diagnostics.add_error(message)

                    errors.append(message)

                    indexed = False

                    if not allow_partial_success:
                        raise

                diagnostics.stages["vector_index"] = _elapsed_ms(stage_start)

            # =================================================================
            # FINALIZE
            # =================================================================

            diagnostics.completed_at = _utc_now_iso()

            diagnostics.duration_ms = _elapsed_ms(started)

            diagnostics.error_count = len(diagnostics.errors)

            # If OCR and Vision both failed, processing is not truly useful.
            if not ocr_text and vision is None:
                success = False

            else:
                success = memory is not None

            if memory is not None:

                memory.metadata["processing"] = diagnostics.to_dict()

                memory.metadata["indexed"] = indexed

                memory.metadata["embedding_generated"] = embedding is not None

                memory.processing_errors = list(
                    dict.fromkeys(
                        [
                            *memory.processing_errors,
                            *errors,
                        ]
                    )
                )[: self.max_errors]

            return ProcessingResult(
                success=success,
                memory=memory,
                image_info=image_info,
                ocr_text=ocr_text,
                vision=vision,
                embedding=embedding,
                indexed=indexed,
                diagnostics=diagnostics,
                error=(errors[0] if errors and not success else None),
            )

        except ProcessingInputError:
            raise

        except Exception as exc:

            logger.exception("MemoryOS processing pipeline failed.")

            message = f"Processing pipeline failed: {exc}"

            diagnostics.add_error(message)

            diagnostics.completed_at = _utc_now_iso()

            diagnostics.duration_ms = _elapsed_ms(started)

            if not allow_partial_success:
                raise ProcessingServiceError(message) from exc

            return ProcessingResult(
                success=False,
                memory=memory,
                image_info=image_info,
                ocr_text=ocr_text,
                vision=vision,
                embedding=embedding,
                indexed=indexed,
                diagnostics=diagnostics,
                error=message,
            )

    # ========================================================================
    # BATCH PROCESSING
    # ========================================================================

    def process_batch(
        self,
        sources: Sequence[Any],
        *,
        source_name: str = DEFAULT_SOURCE,
        index: bool = True,
        allow_partial_success: bool = True,
    ) -> list[ProcessingResult]:
        """
        Process multiple images independently.

        One broken image does not destroy the remaining batch.
        """

        results: list[ProcessingResult] = []

        for position, source in enumerate(
            sources,
            start=1,
        ):

            logger.info(
                "Processing MemoryOS image %s/%s",
                position,
                len(sources),
            )

            try:

                result = self.process(
                    source,
                    source_name=source_name,
                    index=index,
                    allow_partial_success=allow_partial_success,
                )

            except Exception as exc:

                logger.exception(
                    "Batch image %s failed.",
                    position,
                )

                result = ProcessingResult(
                    success=False,
                    memory=None,
                    image_info=ImageInfo(filename=_source_filename(source)),
                    ocr_text="",
                    vision=None,
                    indexed=False,
                    error=str(exc),
                )

            results.append(result)

        return results

    # ========================================================================
    # SUMMARY
    # ========================================================================

    @staticmethod
    def summarize(
        results: Sequence[ProcessingResult],
    ) -> dict[str, Any]:
        """
        Generate a clean batch processing summary.
        """

        total = len(results)

        successful = sum(1 for result in results if result.success)

        failed = total - successful

        indexed = sum(1 for result in results if result.indexed)

        ocr_success = sum(1 for result in results if result.diagnostics.ocr_success)

        vision_success = sum(
            1 for result in results if result.diagnostics.vision_success
        )

        embedding_success = sum(
            1 for result in results if result.diagnostics.embedding_success
        )

        total_duration = sum(result.diagnostics.duration_ms for result in results)

        return {
            "total": total,
            "successful": successful,
            "failed": failed,
            "indexed": indexed,
            "ocr_success": ocr_success,
            "vision_success": vision_success,
            "embedding_success": embedding_success,
            "total_duration_ms": round(
                total_duration,
                2,
            ),
            "average_duration_ms": (
                round(
                    total_duration / total,
                    2,
                )
                if total
                else 0.0
            ),
        }


