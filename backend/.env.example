# ============================================================
# MEMORYOS - BACKEND ENVIRONMENT
# ============================================================

# ------------------------------------------------------------
# LOCAL DEVELOPMENT
# ------------------------------------------------------------
MEMORYOS_ENV=development

# Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.xollllnwzjyavxwlvvxf.supabase.co:5432/postgres

MEMORYOS_CORS_ORIGINS=http://localhost:5173

# Gemini
GEMINI_API_KEY=


# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
SUPABASE_URL=https://xollllnwzjyavxwlvvxf.supabase.co

# Supabase Publishable key
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# IMPORTANT:
# Put your NEWLY ROTATED Supabase secret here.
# NEVER put this value in frontend/Vite environment variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_ROTATED_SECRET

# Private Supabase Storage bucket
SUPABASE_STORAGE_BUCKET=memoryos


# ------------------------------------------------------------
# CLOUD MODE
# ------------------------------------------------------------
# Enable cloud mode now that DATABASE_URL points to PostgreSQL.

MEMORYOS_CLOUD_MODE=true
MEMORYOS_STORAGE_BACKEND=supabase
MEMORYOS_VECTOR_BACKEND=pgvector
MEMORYOS_VECTOR_DIMENSION=384


# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------
# We will generate this later before production deployment.
#
# MEMORYOS_AUTH_SECRET=


# ------------------------------------------------------------
# CLOUD WORKER
# ------------------------------------------------------------
# MEMORYOS_WORKER_MAX_ATTEMPTS=5