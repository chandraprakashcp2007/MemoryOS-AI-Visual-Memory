    files: list[UploadFile] = File(
        ...,
        description=("Multiple JPEG, PNG or WEBP images. " "Maximum 50 files."),
    ),
):
    """
    Upload multiple images.

    One failed file does not invalidate the
    other uploads.
    """

    if not files:

        raise HTTPException(
            status_code=400,
            detail={
                "success": False,
                "error": "empty_batch",
                "message": ("No files were provided."),
            },
        )

    if len(files) > MAX_BATCH_FILES:

        raise HTTPException(
            status_code=400,
            detail={
                "success": False,
                "error": ("batch_limit_exceeded"),
                "message": (
                    f"Maximum " f"{MAX_BATCH_FILES} files " "are allowed per batch."
                ),
            },
        )

    results: list[dict[str, Any]] = []

    successful = 0

    failed = 0

    duplicates = 0

    processed = 0

    for file in files:

        try:

            result = await _handle_upload(file)

            results.append(result)

            successful += 1

            if result.get("duplicate"):
                duplicates += 1

            processing = result.get("processing")

            if isinstance(
                processing,
                dict,
            ) and processing.get("processed"):
                processed += 1

        except UploadServiceError as exc:

            failed += 1

            results.append(
                {
                    "success": False,
                    "filename": safe_filename(file.filename),
                    "error": "upload_failed",
                    "message": str(exc),
                }
            )

        except Exception:

            failed += 1

            logger.exception(
                "Unexpected batch upload failure " "for %s.",
                file.filename,
            )

            results.append(
                {
                    "success": False,
                    "filename": safe_filename(file.filename),
                    "error": ("internal_server_error"),
                    "message": ("Unable to process this file."),
                }
            )

    return {
        "success": failed == 0,
        "total": len(files),
        "successful": successful,
        "failed": failed,
        "duplicates": duplicates,
        "processed": processed,
        "results": results,
        "created_at": utc_now_iso(),
    }


# ============================================================================
# GET /upload/file/{memory_id}
# ============================================================================


@router.get(
    "/file/{memory_id}",
    summary="Retrieve uploaded image",
)
async def get_uploaded_file(
    memory_id: str,
    preview: bool = False,
    thumbnail: bool = False,
):
    """
    Return original image or thumbnail.
    """

    memory_id = clean_string(memory_id)

    if not memory_id:

        raise HTTPException(
            status_code=400,
            detail={
                "success": False,
                "error": ("invalid_memory_id"),
                "message": ("Memory ID is required."),
            },
        )

    if not re.fullmatch(
        r"[A-Za-z0-9_-]+",
        memory_id,
    ):

        raise HTTPException(
            status_code=400,
            detail={
                "success": False,
                "error": ("invalid_memory_id"),
                "message": ("Invalid memory ID."),
            },
        )

    # ------------------------------------------------------------------------
    # PREVIEW / THUMBNAIL
    # ------------------------------------------------------------------------

    if thumbnail or preview:

        preview_file = thumbnail_path(memory_id)

        if preview_file.exists():

            return FileResponse(
                path=preview_file,
                media_type="image/jpeg",
                filename=(f"{memory_id}.jpg"),
                headers={
                    "Cache-Control": ("public, " "max-age=86400"),
                },
            )

    # ------------------------------------------------------------------------
    # ORIGINAL
    # ------------------------------------------------------------------------

    original = find_original(memory_id)

    if original is None:

        raise HTTPException(
            status_code=404,
            detail={
                "success": False,
                "error": ("file_not_found"),
                "message": ("Uploaded image " "could not be found."),
            },
        )

    mime_type = SUPPORTED_EXTENSIONS.get(
        original.suffix.lower(),
        "application/octet-stream",
    )

    return FileResponse(
        path=original,
        media_type=mime_type,
        filename=original.name,
        headers={
            "Cache-Control": ("public, max-age=86400"),
        },
    )


# ============================================================================
# GET /upload/status
# ============================================================================


@router.get(
    "/status",
    summary="Get upload storage status",
)
async def upload_status():
    """Return upload storage statistics."""

    try:

        original_files = sum(
            1
            for extension in SUPPORTED_EXTENSIONS
            for _ in UPLOAD_DIR.glob(f"*{extension}")
        )

        thumbnails = sum(1 for _ in THUMBNAIL_DIR.glob("*.jpg"))

        metadata_files = sum(1 for _ in METADATA_DIR.glob("*.json"))

        upload_bytes = 0

        for extension in SUPPORTED_EXTENSIONS:

            for path in UPLOAD_DIR.glob(f"*{extension}"):

                try:

                    upload_bytes += path.stat().st_size

                except OSError:

                    continue

        return {
            "success": True,
            "status": "ready",
            "storage": {
                "upload_directory": str(UPLOAD_DIR),
                "thumbnail_directory": str(THUMBNAIL_DIR),
                "metadata_directory": str(METADATA_DIR),
                "original_files": (original_files),
                "thumbnails": thumbnails,
                "metadata_files": (metadata_files),
                "storage_bytes": (upload_bytes),
                "storage_mb": round(
                    upload_bytes / (1024 * 1024),
                    2,
                ),
            },
            "limits": {
                "max_file_size_mb": (MAX_FILE_SIZE // (1024 * 1024)),
                "max_batch_files": (MAX_BATCH_FILES),
                "supported_types": sorted(SUPPORTED_MIME_TYPES),
            },
            "timestamp": utc_now_iso(),
        }

    except Exception:

        logger.exception("Unable to calculate upload status.")

        return JSONResponse(
            status_code=500,
            content={
                "success": False,
                "status": "error",
                "error": ("status_unavailable"),
                "message": ("Unable to read upload " "storage status."),
            },
        )


