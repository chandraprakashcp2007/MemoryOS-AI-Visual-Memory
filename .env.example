GEMINI_API_KEY=
# Development defaults. Do not use these values for a deployed API.
MEMORYOS_ENV=development
DATABASE_URL=sqlite:///./data/database/memoryos.db
MEMORYOS_CORS_ORIGINS=http://localhost:5173

# Required for the cloud API deployment.
# DATABASE_URL=postgresql+psycopg://...
# MEMORYOS_CLOUD_MODE=true
# MEMORYOS_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
# SUPABASE_STORAGE_BUCKET=memoryos-private
# MEMORYOS_AUTH_SECRET=<long-random-server-only-secret>
# MEMORYOS_VECTOR_BACKEND=pgvector
# MEMORYOS_VECTOR_DIMENSION=384
# MEMORYOS_WORKER_MAX_ATTEMPTS=5

# Local visual-search acceleration
MEMORYOS_VISUAL_DEVICE=auto
MEMORYOS_VISUAL_BATCH_SIZE=24
MEMORYOS_VISUAL_LOCAL_ONLY=1

# Progressive gallery indexing
MEMORYOS_GALLERY_BATCH_LIMIT=24
MEMORYOS_GALLERY_ENRICH_WORKERS=2

# Multilingual query normalization
MEMORYOS_QUERY_AI_ENABLED=true
MEMORYOS_QUERY_MODEL=gemini-2.5-flash

# MemoryOS AI Copilot
MEMORYOS_ASSISTANT_MODEL=gemini-2.5-flash
MEMORYOS_ASSISTANT_WEB=true
